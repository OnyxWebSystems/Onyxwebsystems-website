# Database (Neon Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
# Public HTTPS origin used for Twilio signature validation (ngrok / Cloudflare / Vercel)
PUBLIC_APP_URL="https://your-tunnel.example"
# If Next binds another port, keep these URLs in sync with the running origin.

# Demo seed login
DEMO_OWNER_EMAIL="demo@onyxwebsystems.com"
DEMO_OWNER_PASSWORD="DemoOnyx2026!"

# LLM (optional — fixture NLU used when unset)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Voice — Retell AI (READY until configured; see docs/live-setup.md + docs/retell-assistant.md)
RETELL_API_KEY=""
RETELL_AGENT_ID=""
RETELL_PHONE_NUMBER=""
RETELL_WEBHOOK_SECRET=""
RETELL_TOOL_SECRET=""
# Dev only — never in production Loom
RETELL_SKIP_SIGNATURE_VERIFY="false"
RETELL_ALLOW_WEBHOOKS_WHEN_READY="false"

# Deprecated — Vapi (kept for reference; webhook returns 410)
# VAPI_API_KEY=""
# VAPI_ASSISTANT_ID=""
# VAPI_PHONE_NUMBER_ID=""
# VAPI_PHONE_NUMBER=""
# VAPI_WEBHOOK_SECRET=""

# Messaging — Twilio SMS + WhatsApp sandbox
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_SMS_FROM=""
# Trial Try out WhatsApp: copy ContentSid (HX…) from the Outbound sample request
TWILIO_WHATSAPP_CONTENT_SID=""
TWILIO_MESSAGING_SERVICE_SID=""
# Dev only — never in production Loom
TWILIO_SKIP_SIGNATURE_VERIFY="false"

# Email — Resend outbound confirmations
# From must be a verified Resend domain, or onboarding@resend.dev for testing.
# Replies still go to ONYX_NOTIFY_EMAIL.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Onyx Web Systems <hello@onyxwebsystems.co.za>"
ONYX_NOTIFY_EMAIL="onyxwebsystems@gmail.com"

# Google Calendar — Onyx Web Systems consultation calendar
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID=""
